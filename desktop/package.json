{
  "name": "@flexipay/desktop",
  "productName": "FlexiPay Desktop Agent",
  "version": "1.0.0",
  "description": "FlexiPay desktop agent for heartbeat, enrollment, and device enforcement.",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "bundle:main": "webpack --config webpack.main.js",
    "bundle:renderer": "webpack --config webpack.renderer.js",
    "bundle": "npm run bundle:main && npm run bundle:renderer",
    "test": "jest --runInBand",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform win32"
  },
  "_moduleAliases": {
    "@main": "src/main",
    "@renderer": "src/renderer"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "module-alias": "^2.2.3",
    "node-schedule": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "electron": "^31.7.7",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "node-windows": "^1.0.0-beta.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
